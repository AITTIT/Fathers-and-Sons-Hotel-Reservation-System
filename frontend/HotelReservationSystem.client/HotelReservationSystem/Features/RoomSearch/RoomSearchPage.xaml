<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HotelReservationSystem.Features.RoomSearch"
             x:Class="HotelReservationSystem.Features.RoomSearch.RoomSearchPage"
             x:DataType="vm:RoomSearchViewModel"
             Title="Find rooms"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}"
             SizeChanged="OnPageSizeChanged">

    <ContentPage.Resources>
        <!-- Rounded, outlined field chrome shared by all inputs in the search card -->
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource FieldStroke}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" HeightRequest="76">
            <Border HorizontalOptions="End" VerticalOptions="Center" Margin="40,0"
                    Stroke="{StaticResource FieldStroke}" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Surface}" Padding="16,0" HeightRequest="44"
                    SemanticProperties.Description="Language and currency">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Image Source="icon_globe.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label Text="English · EUR" TextColor="{StaticResource Ink}"
                           FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <BoxView VerticalOptions="End" HeightRequest="1" Color="{StaticResource Line}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="40,48,40,40" Spacing="32">

                <!-- Heading -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Find your room" TextColor="{StaticResource Ink}"
                           FontFamily="OpenSansSemibold" FontSize="40"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Search available rooms by city, dates and number of guests."
                           TextColor="{StaticResource Muted}" FontSize="16" />
                </VerticalStackLayout>

                <!-- Search card -->
                <Border StrokeShape="RoundRectangle 20" Stroke="{StaticResource Line}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}" Padding="24">
                    <Border.Shadow>
                        <Shadow Brush="#122A33" Opacity="0.08" Radius="24" Offset="0,8" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="20"
                          ColumnDefinitions="5*,4*,4*" ColumnSpacing="16">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="City" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding City}" Placeholder="Where are you going?"
                                       TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                       SemanticProperties.Description="City" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="Check-in" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <DatePicker Date="{Binding CheckIn}" MinimumDate="{Binding MinCheckIn}"
                                            TextColor="{StaticResource Ink}"
                                            VerticalOptions="Center" SemanticProperties.Description="Check-in date" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="2">
                            <Label Text="Check-out" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <DatePicker Date="{Binding CheckOut}" MinimumDate="{Binding MinCheckOut}"
                                            TextColor="{StaticResource Ink}"
                                            VerticalOptions="Center" SemanticProperties.Description="Check-out date" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="9*,10*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Guests" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker ItemsSource="{Binding GuestOptions}"
                                            SelectedIndex="{Binding GuestsIndex}"
                                            TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                            SemanticProperties.Description="Number of guests" />
                                </Border>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" VerticalOptions="End" HeightRequest="48"
                                    Text="Search rooms" ImageSource="icon_search.png"
                                    ContentLayout="Left,10" CornerRadius="10"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    FontFamily="OpenSansSemibold" FontSize="16"
                                    Command="{Binding SearchCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Recommended rooms -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,-24">
                    <Label Text="Recommended rooms" TextColor="{StaticResource Ink}"
                           FontFamily="OpenSansSemibold" FontSize="24"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Grid.Column="1" Text="See all rooms" TextColor="{StaticResource Primary}"
                           FontFamily="OpenSansSemibold" TextDecorations="Underline" VerticalOptions="End" />
                </Grid>

                <CollectionView ItemsSource="{Binding RecommendedRooms}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="RoomsLayout" Orientation="Vertical" Span="3"
                                         HorizontalItemSpacing="24" VerticalItemSpacing="24" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomCardViewModel">
                            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource Line}"
                                    StrokeThickness="1" BackgroundColor="{StaticResource Surface}" Padding="0">
                                <VerticalStackLayout>
                                    <Grid HeightRequest="140" BackgroundColor="{Binding PhotoColor}">
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image Source="icon_bed.png" WidthRequest="20" HeightRequest="20" />
                                            <Label Text="Room photo" TextColor="{StaticResource Muted}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Padding="16,14,16,16" Spacing="4">
                                        <Label Text="{Binding Title}" TextColor="{StaticResource Ink}"
                                               FontFamily="OpenSansSemibold" FontSize="18" />
                                        <Label Text="{Binding Meta}" TextColor="{StaticResource Muted}" />
                                        <HorizontalStackLayout Spacing="6" Margin="0,6,0,0">
                                            <Label Text="{Binding Price}" TextColor="{StaticResource Primary}"
                                                   FontFamily="OpenSansSemibold" FontSize="18" />
                                            <Label Text="/ night" TextColor="{StaticResource Muted}"
                                                   FontSize="16" VerticalOptions="End" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
