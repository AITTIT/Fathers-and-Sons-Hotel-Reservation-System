<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HotelReservationSystem.Features.Staff"
             x:Class="HotelReservationSystem.Features.Staff.StaffDashboardPage"
             x:DataType="vm:StaffDashboardViewModel"
             Title="Dashboard"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="40,48,40,40" Spacing="28">

            <!-- Heading -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding DateText}" TextColor="{StaticResource Muted}" FontSize="16" />
                    <Label Text="{Binding Greeting}" TextColor="{StaticResource Ink}"
                           FontFamily="OpenSansSemibold" FontSize="36"
                           SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ New reservation" VerticalOptions="Center"
                        HeightRequest="48" CornerRadius="10" Padding="20,0"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontFamily="OpenSansSemibold" FontSize="16" Clicked="OnNewReservation" />
            </Grid>

            <!-- Hotel picker -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Start" WidthRequest="360">
                <Label Text="Select hotel" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold" FontSize="14" />
                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource FieldStroke}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}" HeightRequest="48" Padding="12,0">
                    <Picker ItemsSource="{Binding Hotels}" SelectedItem="{Binding SelectedHotel}"
                            TextColor="{StaticResource Ink}" FontSize="16"
                            VerticalOptions="Center" HeightRequest="40"
                            SemanticProperties.Description="Choose a hotel" />
                </Border>
            </VerticalStackLayout>

            <!-- Stat tiles -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tiles}" Spacing="20"
                                 HorizontalOptions="Start" WidthRequest="360">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTile">
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Padding="20,18"
                                Stroke="{StaticResource Line}" BackgroundColor="{StaticResource Surface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAlert}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Label}" TextColor="{StaticResource Muted}" FontSize="14" />
                                <Label Text="{Binding Value}" TextColor="{StaticResource Ink}"
                                       FontFamily="OpenSansSemibold" FontSize="36" />
                                <Label Text="{Binding Detail}" TextColor="{StaticResource Muted}" FontSize="14" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Today's arrivals -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Today's arrivals" TextColor="{StaticResource Ink}"
                       FontFamily="OpenSansSemibold" FontSize="24" SemanticProperties.HeadingLevel="Level2" />
                <Label Grid.Column="1" Text="All reservations ›" TextColor="{StaticResource Primary}"
                       FontFamily="OpenSansSemibold" VerticalOptions="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenReservations" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{StaticResource Line}"
                    BackgroundColor="{StaticResource Surface}" Padding="0">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,2*,*,*" Padding="20,14" BackgroundColor="{StaticResource PageBackground}">
                        <Label Text="Booking" FontFamily="OpenSansSemibold" TextColor="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="Guest" FontFamily="OpenSansSemibold" TextColor="{StaticResource Muted}" />
                        <Label Grid.Column="2" Text="Room" FontFamily="OpenSansSemibold" TextColor="{StaticResource Muted}" />
                        <Label Grid.Column="3" Text="Status" FontFamily="OpenSansSemibold" TextColor="{StaticResource Muted}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Arrivals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArrivalRow">
                                <VerticalStackLayout>
                                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                    <Grid ColumnDefinitions="*,2*,*,*" Padding="20,16">
                                        <Label Text="{Binding Booking}" TextColor="{StaticResource Ink}" />
                                        <Label Grid.Column="1" Text="{Binding Guest}" TextColor="{StaticResource Ink}" />
                                        <Label Grid.Column="2" Text="{Binding Room}" TextColor="{StaticResource Ink}" />
                                        <Label Grid.Column="3" Text="{Binding Status}" TextColor="{Binding StatusColor}"
                                               FontFamily="OpenSansSemibold" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
