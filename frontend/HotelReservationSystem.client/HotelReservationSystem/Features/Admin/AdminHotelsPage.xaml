<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HotelReservationSystem.Features.Admin"
             x:Class="HotelReservationSystem.Features.Admin.AdminHotelsPage"
             x:DataType="vm:AdminHotelsViewModel"
             Title="Hotels and rooms"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource FieldStroke}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="20,0" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="40,48,40,40" Spacing="20">

            <!-- Heading -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Label Text="Hotels and rooms" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold"
                       FontSize="36" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />
                <Button Grid.Column="1" Text="+ Add hotel" VerticalOptions="Center"
                        Style="{StaticResource PrimaryButton}" Command="{Binding ShowHotelFormCommand}" />
                <Button Grid.Column="2" Text="+ Add room" VerticalOptions="Center"
                        Style="{StaticResource PrimaryButton}" Command="{Binding ShowRoomFormCommand}" />
            </Grid>

            <!-- Add hotel -->
            <Border IsVisible="{Binding IsAddingHotel}" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                    Stroke="{StaticResource Line}" BackgroundColor="{StaticResource Surface}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="New hotel" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold"
                           FontSize="20" SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding HotelName}" Placeholder="Hotel name" TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource Muted}" VerticalOptions="Center"
                                   SemanticProperties.Description="Hotel name" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding HotelAddress}" Placeholder="Address" TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource Muted}" VerticalOptions="Center"
                                   SemanticProperties.Description="Address" />
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding HotelCity}" Placeholder="City" TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource Muted}" VerticalOptions="Center"
                                   SemanticProperties.Description="City" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding HotelCountry}" Placeholder="Country" TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource Muted}" VerticalOptions="Center"
                                   SemanticProperties.Description="Country" />
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding HotelPostalCode}" Placeholder="Postal code (optional)"
                                   TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}"
                                   VerticalOptions="Center" ReturnCommand="{Binding CreateHotelCommand}"
                                   SemanticProperties.Description="Postal code" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding HotelFormError}" IsVisible="{Binding HasHotelFormError}" TextColor="#B3261E" />
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                        <Button Text="Cancel" Style="{StaticResource LinkButton}" Command="{Binding CancelHotelCommand}" />
                        <Button Text="Add hotel" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateHotelCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Add room -->
            <Border IsVisible="{Binding IsAddingRoom}" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                    Stroke="{StaticResource Line}" BackgroundColor="{StaticResource Surface}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="New room" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold"
                           FontSize="20" SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding Hotels}" SelectedItem="{Binding RoomHotel}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=vm:ManagedHotel}"
                                    Title="Hotel" TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                    SemanticProperties.Description="Hotel" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding RoomNumber}" Placeholder="Room number" TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource Muted}" VerticalOptions="Center"
                                   SemanticProperties.Description="Room number" />
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding RoomType}" Placeholder="Room type (Single, Double, Suite...)"
                                   TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}"
                                   VerticalOptions="Center" SemanticProperties.Description="Room type" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding RoomCapacity}" Keyboard="Numeric" Placeholder="Capacity (guests)"
                                   TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}"
                                   VerticalOptions="Center" SemanticProperties.Description="Capacity" />
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding RoomPrice}" Keyboard="Numeric" Placeholder="Price per night (€)"
                                   TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}"
                                   VerticalOptions="Center" ReturnCommand="{Binding CreateRoomCommand}"
                                   SemanticProperties.Description="Price per night" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding RoomFormError}" IsVisible="{Binding HasRoomFormError}" TextColor="#B3261E" />
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                        <Button Text="Cancel" Style="{StaticResource LinkButton}" Command="{Binding CancelRoomCommand}" />
                        <Button Text="Add room" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateRoomCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontFamily="OpenSansSemibold">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="#2E8B57" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="#B3261E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>

            <!-- Hotels with their rooms -->
            <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotelRow">
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{StaticResource Line}"
                                BackgroundColor="{StaticResource Surface}" Padding="20">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" TextColor="{StaticResource Ink}"
                                           FontFamily="OpenSansSemibold" FontSize="20" />
                                    <Label Grid.Column="1" Text="{Binding RoomCount}"
                                           TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Location}" TextColor="{StaticResource Muted}" FontSize="14" />
                                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RoomRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RoomRow">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Text}" TextColor="{StaticResource Ink}"
                                                       VerticalOptions="Center" Padding="0,2" />
                                                <Button Grid.Column="1" Text="Remove" Style="{StaticResource LinkButton}"
                                                        TextColor="#B3261E" Clicked="OnRemoveRoom"
                                                        SemanticProperties.Description="Remove room" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="No rooms yet." IsVisible="{Binding HasNoRooms}"
                                       TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="No hotels yet." IsVisible="{Binding HasNoRows}" TextColor="{StaticResource Muted}" />

            <Label Text="Demo data: changes are lost when the app closes. Rooms added here appear in room search."
                   TextColor="{StaticResource Muted}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
