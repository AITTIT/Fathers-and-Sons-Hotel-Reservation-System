<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HotelReservationSystem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:search="clr-namespace:HotelReservationSystem.Features.RoomSearch"
    xmlns:staff="clr-namespace:HotelReservationSystem.Features.Staff"
    xmlns:admin="clr-namespace:HotelReservationSystem.Features.Admin"
    xmlns:placeholders="clr-namespace:HotelReservationSystem.Features.Placeholders"
    Title="Hotel Reservation"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Locked"
    FlyoutWidth="248"
    FlyoutBackgroundColor="{StaticResource Sidebar}">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="22,28,8,20" Spacing="14">
            <HorizontalStackLayout Spacing="12">
                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Accent}">
                    <Label Text="H" TextColor="{StaticResource AccentText}" FontFamily="OpenSansSemibold"
                           FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Hotel Reservation" TextColor="White" FontFamily="OpenSansSemibold"
                       FontSize="18" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border x:Name="AdminBadge" IsVisible="False" HorizontalOptions="Start" Padding="10,3"
                    StrokeThickness="1" Stroke="{StaticResource Accent}" StrokeShape="RoundRectangle 6">
                <Label Text="ADMIN" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold"
                       FontSize="12" />
            </Border>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Border HeightRequest="44" WidthRequest="220" Margin="14,3" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter TargetName="NavLabel" Property="Label.TextColor" Value="{StaticResource SidebarText}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SidebarActive}" />
                                    <Setter TargetName="NavLabel" Property="Label.TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Grid ColumnDefinitions="44,*">
                    <Image Source="{Binding FlyoutIcon}" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="NavLabel" Grid.Column="1" Text="{Binding Title}"
                           FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem x:Name="StaffDashboardItem" Title="Dashboard" Icon="icon_calendar.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate staff:StaffDashboardPage}" Route="staff" />
    </FlyoutItem>
    <FlyoutItem x:Name="StaffReservationsItem" Title="Reservations" Icon="icon_bed.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate placeholders:StaffReservationsPage}" Route="staffreservations" />
    </FlyoutItem>
    <FlyoutItem x:Name="StaffRoomsItem" Title="Rooms" Icon="icon_bed.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate placeholders:StaffRoomsPage}" Route="staffrooms" />
    </FlyoutItem>
    <FlyoutItem x:Name="StaffCustomersItem" Title="Customers" Icon="icon_globe.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate placeholders:StaffCustomersPage}" Route="staffcustomers" />
    </FlyoutItem>

    <FlyoutItem x:Name="AdminUsersItem" Title="Users" Icon="icon_globe.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate admin:AdminUsersPage}" Route="admin" />
    </FlyoutItem>
    <FlyoutItem x:Name="AdminLogsItem" Title="Application logs" Icon="icon_help.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate placeholders:AdminLogsPage}" Route="adminlogs" />
    </FlyoutItem>
    <FlyoutItem x:Name="AdminAuditItem" Title="Audit trail" Icon="icon_calendar.png" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate placeholders:AdminAuditPage}" Route="adminaudit" />
    </FlyoutItem>

    <FlyoutItem x:Name="CustomerRoomsItem" Title="Find rooms" Icon="icon_search.png">
        <ShellContent ContentTemplate="{DataTemplate search:RoomSearchPage}" Route="rooms" />
    </FlyoutItem>

    <FlyoutItem x:Name="CustomerBookingsItem" Title="My bookings" Icon="icon_calendar.png">
        <ShellContent ContentTemplate="{DataTemplate placeholders:MyBookingsPage}" Route="bookings" />
    </FlyoutItem>

    <FlyoutItem x:Name="CustomerHelpItem" Title="Help &amp; FAQ" Icon="icon_help.png">
        <ShellContent ContentTemplate="{DataTemplate placeholders:HelpPage}" Route="help" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="22,0,22,22" Spacing="14">
            <BoxView HeightRequest="1" Color="{StaticResource SidebarLine}" />
            <Label x:Name="UserLabel" Text="Browsing as guest" TextColor="{StaticResource SidebarText}" FontSize="14" />
            <Button x:Name="AuthButton" Text="Sign in or register" BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource AccentText}" FontFamily="OpenSansSemibold"
                    FontSize="16" CornerRadius="10" HeightRequest="48" Clicked="OnAuthButtonClicked" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
